<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Le "parent" fournit la gestion centralisée des versions de dépendances.
         Grâce à lui, on n'écrit AUCUN numéro de version pour les starters Spring. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- va chercher le parent dans le dépôt Maven, pas sur le disque -->
    </parent>

    <!-- Coordonnées de NOTRE artefact : groupId:artifactId:version -->
    <groupId>com.formation</groupId>
    <artifactId>taskops-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>taskops-api</name>
    <description>API REST de gestion de taches - projet fil rouge DevOps B3</description>

    <properties>
        <!-- Version du langage utilisée pour compiler ET exécuter -->
        <java.version>25</java.version>
        <!-- Encodage explicite : evite les surprises entre Windows, macOS et la CI Linux -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Coordonnees SonarQube Cloud -->
        <sonar.organization>nchami-coda</sonar.organization>
        <sonar.projectKey>nchami-coda_taskops-api</sonar.projectKey>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <!-- Indique a Sonar ou trouver le rapport de couverture produit par JaCoCo -->
        <sonar.coverage.jacoco.xmlReportPaths>
            ${project.build.directory}/site/jacoco/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <dependencies>
        <!-- Serveur web embarque (Tomcat) + Spring MVC : permet d'exposer des controleurs REST.
             ATTENTION : depuis Spring Boot 4.0, ce starter s'appelle "spring-boot-starter-webmvc".
             Jusqu'a Spring Boot 3.x il s'appelait "spring-boot-starter-web" : la plupart
             des tutoriels en ligne utilisent encore l'ancien nom. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Persistance : Spring Data JPA + Hibernate. Fournit les repositories automatiques -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Validation des donnees entrantes via les annotations @NotBlank, @Size, etc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator : expose l'etat et les metadonnees de l'application.
             Indispensable pour les smoke tests (ce module), les probes
             Kubernetes (Module 7) et Prometheus (Module 8). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Base de donnees H2, en memoire. Portee "runtime" : utile a l'execution,
             inutile a la compilation. Sera remplacee par PostgreSQL au Module 5. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Boite a outils de test : JUnit 5 (Jupiter), AssertJ, Mockito, MockMvc.
             Portee "test" : jamais embarquee dans le livrable. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Plugin Spring Boot : produit un JAR executable et fournit "mvn spring-boot:run" -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- Genere META-INF/build-info.properties DANS le JAR :
                         version, date de construction, artifactId.
                         Actuator le lit et l'expose sur /actuator/info. -->
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- JaCoCo : instrumente le bytecode pour savoir quelles lignes
                 sont executees pendant les tests.
                 0.8.14 est la premiere version supportant officiellement Java 25 :
                 une version plus ancienne echouera sur du bytecode version 69. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <executions>
                    <!-- 1. Active l'agent JaCoCo AVANT l'execution des tests -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- 2. Genere le rapport HTML + XML APRES les tests -->
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>